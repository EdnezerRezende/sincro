FROM ghcr.io/cirruslabs/flutter:stable AS build
WORKDIR /app
COPY . .
RUN flutter pub get
# Defaults to the browser's own localhost: the mobile-web container serves static assets that
# then run in the *user's* browser on the host, not inside the Docker network — so it needs the
# backend's host-published port (docker-compose.yml maps backend's 3000 to the host), not a
# Docker-internal service name like `backend:3000`. The app's own compiled-in default
# (10.0.2.2, api_providers.dart) is for the Android emulator instead, and would time out here.
ARG API_BASE_URL=http://localhost:3000
RUN flutter build web --release --dart-define=API_BASE_URL=$API_BASE_URL

FROM nginx:alpine AS runtime
COPY --from=build /app/build/web /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
