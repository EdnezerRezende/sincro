# --- Anúncios (AdMob) — lidos por GET /users/me/features ---
# Chave-mestra. Desligado por padrão.
ADS_ENABLED="false"
# Liga/desliga cada formato individualmente (só valem com ADS_ENABLED=true).
ADS_BANNER_ENABLED="true"
ADS_INTERSTITIAL_ENABLED="true"
ADS_REWARDED_ENABLED="true"
# Planos (coluna usuarios.plano, separados por vírgula) que nunca veem anúncios.
ADS_FREE_PLANS="pro"
# Frequency capping do intersticial (segundos entre exibições).
ADS_INTERSTITIAL_MIN_INTERVAL_SECONDS="180"
# Duração do desbloqueio ganho ao assistir um anúncio premiado (minutos).
ADS_REWARDED_UNLOCK_MINUTES="60"
# Sincronizações manuais por dia no plano gratuito (vazio = ilimitado).
FREE_MANUAL_SYNCS_PER_DAY=""
