generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id              String           @id @default(uuid())
  firebaseUid     String           @unique @map("firebase_uid")
  nome            String
  createdAt       DateTime         @default(now()) @map("created_at")
  plano           String           @default("simples")
  fcmToken        String?          @map("fcm_token")
  diaRecebimento  Int?             @map("dia_recebimento")
  isAdmin         Boolean          @default(false) @map("is_admin")
  sensoryProfile  SensoryProfile?
  trustedContacts TrustedContact[]
  gmailConnection GmailConnection?
  emailSummaries  EmailSummary[]
  cardFavoritos   CardFavorito[]

  @@map("usuarios")
}

model SensoryProfile {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  dados     Json
  versao    Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("perfis_sensoriais")
}

model TrustedContact {
  id                    String   @id @default(uuid())
  userId                String   @map("user_id")
  user                  User     @relation(fields: [userId], references: [id])
  nome                  String
  relacao               String
  whatsapp              String
  prioridade            Int      @default(0)
  consentimentoAceitoEm DateTime @map("consentimento_aceito_em")
  createdAt             DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("contatos_confianca")
}

model GmailConnection {
  id                        String    @id @default(uuid())
  userId                    String    @unique @map("user_id")
  user                      User      @relation(fields: [userId], references: [id])
  refreshTokenCriptografado String    @map("refresh_token_criptografado")
  gmailEmail                String    @map("gmail_email")
  lastHistoryId             String?   @map("last_history_id")
  ultimaSincronizacao       DateTime? @map("ultima_sincronizacao")
  temEscopoEnvio            Boolean   @default(false) @map("tem_escopo_envio")
  temEscopoAgenda           Boolean   @default(false) @map("tem_escopo_agenda")
  temEscopoModificacao      Boolean   @default(false) @map("tem_escopo_modificacao")
  criadoEm                  DateTime  @default(now()) @map("criado_em")

  @@map("conexoes_gmail")
}

model EmailSummary {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id])
  gmailMessageId String   @map("gmail_message_id")
  remetente      String
  assunto        String
  resumoCurto    String   @map("resumo_curto")
  categoria      String
  recebidoEm     DateTime @map("recebido_em")
  lidoNoApp      Boolean  @default(false) @map("lido_no_app")
  criadoEm       DateTime @default(now()) @map("criado_em")

  @@unique([userId, gmailMessageId])
  @@index([userId])
  @@map("resumos_email")
}

model Professional {
  id           String   @id @default(uuid())
  nome         String
  tags         String[]
  cidade       String
  latitude     Float
  longitude    Float
  telefone     String
  bio          String
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em")

  @@index([ativo])
  @@map("profissionais")
}

model GroundingCard {
  id           String         @id @default(uuid())
  titulo       String
  categoria    String
  conteudo     String
  ativo        Boolean        @default(true)
  criadoEm     DateTime       @default(now()) @map("criado_em")
  atualizadoEm DateTime       @default(now()) @updatedAt @map("atualizado_em")
  favoritos    CardFavorito[]

  @@index([ativo])
  @@map("cartoes_aterramento")
}

model CardFavorito {
  id       String        @id @default(uuid())
  userId   String        @map("user_id")
  user     User          @relation(fields: [userId], references: [id])
  cardId   String        @map("card_id")
  card     GroundingCard @relation(fields: [cardId], references: [id])
  criadoEm DateTime      @default(now()) @map("criado_em")

  @@unique([userId, cardId])
  @@index([userId])
  @@map("cartoes_favoritos")
}

enum TipoContaFinanceira {
  CORRENTE
  CARTEIRA
  POUPANCA
}

enum TipoLancamento {
  DESPESA
  RECEITA
  FATURA_CARTAO
}

enum StatusLancamento {
  PENDENTE_REVISAO
  CONFIRMADO
  IGNORADO
}

enum OrigemLancamento {
  EMAIL_PARSER
  MANUAL
}

model ContaFinanceira {
  id           String                 @id @default(uuid())
  userId       String                 @map("user_id")
  nome         String
  tipo         TipoContaFinanceira
  saldoAtual   Decimal                @map("saldo_atual") @db.Decimal(14, 2)
  cor          String?
  criadoEm     DateTime               @default(now()) @map("criado_em")
  atualizadoEm DateTime               @default(now()) @updatedAt @map("atualizado_em")
  lancamentos  LancamentoFinanceiro[]

  @@index([userId])
  @@map("contas_financeiras_v2")
}

model CartaoCredito {
  id            String                 @id @default(uuid())
  userId        String                 @map("user_id")
  nome          String
  diaFechamento Int                    @map("dia_fechamento")
  diaVencimento Int                    @map("dia_vencimento")
  limiteTotal   Decimal                @map("limite_total") @db.Decimal(14, 2)
  cor           String?
  criadoEm      DateTime               @default(now()) @map("criado_em")
  atualizadoEm  DateTime               @default(now()) @updatedAt @map("atualizado_em")
  lancamentos   LancamentoFinanceiro[]

  @@index([userId])
  @@map("cartoes_credito")
}

model LancamentoFinanceiro {
  id              String            @id @default(uuid())
  userId          String            @map("user_id")
  tipo            TipoLancamento
  descricao       String
  instituicao     String?
  valor           Decimal?          @db.Decimal(14, 2)
  dataVencimento  DateTime          @map("data_vencimento") @db.Date
  dataCompetencia DateTime          @map("data_competencia") @db.Date
  status          StatusLancamento  @default(PENDENTE_REVISAO)
  origem          OrigemLancamento
  isPago          Boolean           @default(false) @map("is_pago")
  emailMessageId  String?           @map("email_message_id")
  codigoBarras    String?           @map("codigo_barras")
  cartaoId        String?           @map("cartao_id")
  contaId         String?           @map("conta_id")
  googleEventId   String?           @map("google_event_id")
  criadoEm        DateTime          @default(now()) @map("criado_em")
  atualizadoEm    DateTime          @default(now()) @updatedAt @map("atualizado_em")

  cartao          CartaoCredito?    @relation(fields: [cartaoId], references: [id])
  conta           ContaFinanceira?  @relation(fields: [contaId], references: [id])

  @@unique([userId, emailMessageId])
  @@index([userId, status])
  @@index([userId, dataVencimento])
  @@map("lancamentos_financeiros")
}

model KnowledgeDocument {
  id        String           @id @default(uuid())
  titulo    String
  arquivo   String
  tipo      String
  categoria String
  criadoEm  DateTime         @default(now()) @map("criado_em")
  chunks    KnowledgeChunk[]

  @@map("knowledge_documents")
}

/// ATENÇÃO: esta tabela tem 2 índices criados via SQL bruto na migration
/// `20260803210000_add_rag_knowledge_base` que NÃO podem ser declarados aqui —
/// `knowledge_chunks_embedding_hnsw_idx` (HNSW não é um tipo de índice suportado
/// pelo Prisma) e `knowledge_chunks_fts_idx` (índice GIN sobre uma expressão
/// `to_tsvector`, não uma coluna). O Prisma não os enxerga e vai propor DROP
/// INDEX para os dois em qualquer `prisma migrate dev` normal. Sempre rode
/// `prisma migrate dev --create-only` para esta tabela e remova manualmente
/// qualquer DROP INDEX gerado para eles antes de aplicar.
model KnowledgeChunk {
  id          String            @id @default(uuid())
  documentoId String            @map("documento_id")
  documento   KnowledgeDocument @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  conteudo    String
  indiceChunk Int               @map("indice_chunk")
  embedding   Unsupported("vector(1536)")?
  metadados   Json?
  criadoEm    DateTime          @default(now()) @map("criado_em")

  @@index([documentoId])
  @@map("knowledge_chunks")
}
